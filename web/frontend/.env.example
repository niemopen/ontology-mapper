# Demo mode is ON by default (matches backend DEMO_MODE=1). A fresh
# checkout — including the OASIS share — runs without any Clerk config.
# Set VITE_DEMO_MODE=0 and fill in VITE_CLERK_PUBLISHABLE_KEY for real auth.

VITE_DEMO_MODE=1

# Clerk publishable key — used only when VITE_DEMO_MODE=0.
VITE_CLERK_PUBLISHABLE_KEY=
