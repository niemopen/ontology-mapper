# ─── Authentication ──────────────────────────────────────────────────────
#
# DEMO MODE IS THE DEFAULT. A fresh checkout — including the OASIS share —
# runs without any Clerk configuration. Every request resolves to a fixed
# `demo-user` in the `demo` organization with admin rights.
#
# To enable real Clerk auth (production, maintainer dev with Clerk), set
# DEMO_MODE=0 and fill in the Clerk keys below.

DEMO_MODE=1

# Clerk credentials — used only when DEMO_MODE=0.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ─── Pipeline data ───────────────────────────────────────────────────────
# Defaults resolve to ../runner relative to the OntologyMapper repo root.
# Override only when running the runner from a different location.

RUNS_DIR=C:/dev/OntologyMapper/runner/.compiler-runs
RUNNER_DIR=C:/dev/OntologyMapper/runner

# ─── Backend ─────────────────────────────────────────────────────────────

BACKEND_PORT=8000

# Clerk user ID (sub claim) granted admin access. Ignored in demo mode
# (the demo user is always admin).
ADMIN_USER_ID=
